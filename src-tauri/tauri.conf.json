{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blue Battery",
  "version": "0.1.0",
  "identifier": "com.sulaw.bluebattery",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blue Battery",
        "width": 360,
        "height": 460,
        "minWidth": 320,
        "minHeight": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "color": "#F3F3F3CC"
        },
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
